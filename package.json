{
  "name": "claude-arena",
  "displayName": "Claude Arena",
  "description": "Dashboard pixel art temps réel des agents Claude Code actifs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"cd webview-ui && npx vite --port 5173\" \"npx tsx --watch server/index.ts\"",
    "build:webview": "cd webview-ui && npm run build",
    "build:server": "npx tsc -p tsconfig.server.json",
    "build": "npm run build:webview && npm run build:server",
    "start": "npm run build && node dist-server/index.js",
    "server": "npx tsx server/index.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pngjs": "^7.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.5.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
